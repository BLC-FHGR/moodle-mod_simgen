{{!
    @template mod_simgen/player

    Sandboxed simulation player.

    Context variables required for this template:
    * wrapperid - id of the wrapper element
    * src - URL of sim.php
    * title - accessible title of the iframe
    * minheight - minimal height in px
    * sandbox - sandbox flags
    * showreset - show the "restart" button
    * completed - the user completed the simulation before
    * preview - teacher preview of a draft

    Example context (json):
    {
        "wrapperid": "mod-simgen-player-1",
        "src": "https://example.org/mod/simgen/sim.php?id=1",
        "title": "Marktgleichgewicht",
        "minheight": 600,
        "sandbox": "allow-scripts allow-forms",
        "showreset": true,
        "completed": false,
        "preview": false
    }
}}
<div class="mod-simgen-player" id="{{wrapperid}}">
    <div class="mod-simgen-toolbar">
        {{#preview}}
            <span class="badge badge-warning bg-warning text-dark">{{#str}}preview_badge, mod_simgen{{/str}}</span>
        {{/preview}}
        {{#completed}}
            <span class="badge badge-success bg-success">{{#str}}player_completedbefore, mod_simgen{{/str}}</span>
        {{/completed}}
        <span class="mod-simgen-savestatus small text-muted" data-region="savestatus" aria-live="polite"></span>
        <span class="mod-simgen-spacer"></span>
        {{#showreset}}
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="reset">
                {{#str}}player_reset, mod_simgen{{/str}}
            </button>
        {{/showreset}}
        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="fullscreen">
            {{#str}}player_fullscreen, mod_simgen{{/str}}
        </button>
    </div>
    <iframe class="mod-simgen-frame"
            src="{{src}}"
            title="{{title}}"
            sandbox="{{sandbox}}"
            referrerpolicy="no-referrer"
            loading="eager"
            style="height: {{minheight}}px;"></iframe>
</div>
